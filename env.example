# Optional: full OAuth (private repos). Public username scoring works without this.
# Create an OAuth App → https://github.com/settings/developers
# Homepage URL: http://localhost:4321
# Authorization callback URL: http://localhost:4321/api/auth/github/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional override (defaults to {origin}/api/auth/github/callback)
# GITHUB_REDIRECT_URI=http://localhost:4321/api/auth/github/callback
